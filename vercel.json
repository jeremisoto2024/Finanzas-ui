{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },

  "crons": [
    {
      "path": "/api/cron/cierre-mensual",
      "schedule": "0 0 1 * *"
    }
  ],

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}